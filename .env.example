# UAPI Pro API Key (可选，但推荐用于更高的请求限额)
UAPI_PRO_API_KEY=your-uapi-pro-api-key

# MCP API Keys (用于认证，逗号分隔)
# 生成方法: openssl rand -hex 32
MCP_API_KEYS=key1,key2,key3

# 应用URL (用于OAuth元数据)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI 兼容生图供应商池（可选）
# 匹配 models 的供应商会按请求哈希负载均衡；失败自动按顺序切换到下一个。
# apiKeyEnv 推荐用于引用单独的密钥环境变量；也可直接在 JSON 中填写 apiKey。
# OPENAI_IMAGE_PROVIDERS=[{"id":"provider-a","baseUrl":"https://api.example.com/v1","apiKeyEnv":"PROVIDER_A_API_KEY","models":["gpt-image-1"],"modelMap":{"gpt-image-1":"dall-e-3"}},{"id":"provider-b","baseUrl":"https://another.example.com/v1","apiKeyEnv":"PROVIDER_B_API_KEY","models":["gpt-image-1"]}]
# PROVIDER_A_API_KEY=your-provider-a-key
# PROVIDER_B_API_KEY=your-provider-b-key
#
# 单供应商简写（与上面的 JSON 二选一）：
# OPENAI_IMAGE_BASE_URL=https://api.example.com/v1
# OPENAI_IMAGE_API_KEY=your-api-key
# OPENAI_IMAGE_MODELS=gpt-image-1,dall-e-3

# 开发环境设置
NODE_ENV=development
